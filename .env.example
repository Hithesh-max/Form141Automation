# =================================================================
# Form 141 Filing Automation Configuration Template
# =================================================================
# Copy this file to .env and configure for your environment.
# NEVER commit .env with real passwords, keys, or tax credentials to Git.

# -----------------------------------------------------------------
# 1. Environment & Mode
# -----------------------------------------------------------------
# development | staging | production
ENV=development

# Portal mode: mock (safe local testing) | real (Income Tax portal)
PORTAL_MODE=mock

# -----------------------------------------------------------------
# 2. Database Configuration
# -----------------------------------------------------------------
# For Local Development (SQLite):
DATABASE_URL=sqlite:///./form141.db

# For Production (PostgreSQL with psycopg binary driver):
# In Docker Compose, the host is 'postgres'.
POSTGRES_USER=form141_user
POSTGRES_PASSWORD=change_this_to_a_strong_password_in_production
POSTGRES_DB=form141
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------
# 3. Redis Queue & Event Bus
# -----------------------------------------------------------------
# Local development: localhost:6379; Docker Compose: redis:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# -----------------------------------------------------------------
# 4. Security & Cryptography
# -----------------------------------------------------------------
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=generate_with_fernet_generate_key

# JWT / Session Secret for API and viewer token signing:
SECRET_KEY=generate_a_random_32_byte_hex_string

# -----------------------------------------------------------------
# 5. Worker & Browser Automation
# -----------------------------------------------------------------
# BROWSER_HEADLESS: false on Windows development and Linux with Xvfb
BROWSER_HEADLESS=false
MAX_CONCURRENT_JOBS=1
MAX_RETRIES=3
PAGE_TIMEOUT=30000
ELEMENT_TIMEOUT=15000
HEARTBEAT_INTERVAL=5000

# Virtual Display & Remote Viewer (Linux VPS / Docker only)
# DISPLAY=:99 is created by Xvfb in the worker container
DISPLAY=:99
VNC_PORT=5900
VNC_PASSWORD=change_vnc_internal_secret

# -----------------------------------------------------------------
# 6. Frontend / API Reverse Proxy
# -----------------------------------------------------------------
# Safe public variables for Vite frontend (do NOT place secrets here)
VITE_API_BASE=
VITE_WS_URL=
WEBSOCKET_RECONNECT=true
